{
  "name": "Wama-Pay – Order Paid Receipt",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wama-pay/order-paid",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-order-paid",
      "name": "Webhook: Order Paid",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-800, 0],
      "webhookId": "wama-pay-order-paid"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://qhnqselrrawmgcrpuazx.supabase.co/rest/v1/orders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{$json.body.order_id}}" },
            { "name": "select", "value": "id,amount_cents,currency,paid_at,customers(email,full_name),products(name),devices(label)" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$credentials.supabaseServiceRole.apiKey}}" },
            { "name": "Authorization", "value": "=Bearer {{$credentials.supabaseServiceRole.apiKey}}" }
          ]
        },
        "options": {}
      },
      "id": "http-load-order",
      "name": "Order + Kunde laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-560, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "supabase-service-role", "name": "Supabase Service Role" }
      }
    },
    {
      "parameters": {
        "jsCode": "const order = Array.isArray($input.first().json) ? $input.first().json[0] : $input.first().json[0];\nreturn [{ json: order }];"
      },
      "id": "code-unwrap-order",
      "name": "Order-Datensatz entpacken",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-customer-email",
              "leftValue": "={{$json.customers?.email}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-email",
      "name": "Kunde mit E-Mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "fromEmail": "info@energy-leisure.de",
        "toEmail": "={{$json.customers.email}}",
        "subject": "Ihre Zahlungsbestätigung – Wama-Pay",
        "emailFormat": "text",
        "text": "=Hallo {{$json.customers.full_name || ''}},\n\nvielen Dank für Ihre Zahlung.\n\nGerät: {{$json.devices?.label}}\nLeistung: {{$json.products?.name}}\nBetrag: {{($json.amount_cents / 100).toFixed(2)}} {{$json.currency}}\nZeitpunkt: {{$json.paid_at}}\n\nViele Grüße\nWama-Pay",
        "options": {}
      },
      "id": "send-receipt-email",
      "name": "Beleg-Mail senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [180, -100],
      "credentials": {
        "smtp": { "id": "wama-pay-smtp", "name": "Wama-Pay SMTP" }
      }
    },
    {
      "parameters": {},
      "id": "noop-anonymous",
      "name": "Anonymer Checkout – kein Beleg per Mail",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [180, 120]
    }
  ],
  "connections": {
    "Webhook: Order Paid": { "main": [[{ "node": "Order + Kunde laden", "type": "main", "index": 0 }]] },
    "Order + Kunde laden": { "main": [[{ "node": "Order-Datensatz entpacken", "type": "main", "index": 0 }]] },
    "Order-Datensatz entpacken": { "main": [[{ "node": "Kunde mit E-Mail?", "type": "main", "index": 0 }]] },
    "Kunde mit E-Mail?": {
      "main": [
        [{ "node": "Beleg-Mail senden", "type": "main", "index": 0 }],
        [{ "node": "Anonymer Checkout – kein Beleg per Mail", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
